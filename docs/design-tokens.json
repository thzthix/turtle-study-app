{
  "meta": {
    "name": "turtle-study-handoff-tokens",
    "version": "0.1.0",
    "sourcePriority": {
      "turtleStates": "reference-board-turtle-ui.png",
      "sceneAndShell": "reference-board-scene.png"
    },
    "status": "handoff-reference"
  },
  "color": {
    "paper": "#FBF7EB",
    "cream": "#F6EBCF",
    "sunGlow": "#F5D978",
    "peachBlush": "#F2C9A7",
    "sageLight": "#C9D8AE",
    "oliveSoft": "#A8BA6E",
    "moss": "#7E9560",
    "textPrimary": "#6A7458",
    "textSecondary": "#8A7B62",
    "hudFill": "rgba(255, 251, 241, 0.78)",
    "overlayLine": "rgba(214, 202, 175, 0.72)",
    "overlayShadow": "rgba(120, 112, 84, 0.10)"
  },
  "font": {
    "direction": "rounded, gentle, handwritten-friendly without becoming childish",
    "titleWeight": 700,
    "bodyWeight": 500,
    "trackingUppercase": "0.12em"
  },
  "radius": {
    "overlayCard": 28,
    "overlayPopup": 32,
    "pill": 999,
    "iconButton": 999
  },
  "shadow": {
    "overlaySoft": "0 12px 28px rgba(120, 112, 84, 0.10)",
    "overlayFocus": "0 18px 36px rgba(120, 112, 84, 0.12)"
  },
  "spacing": {
    "xs": 8,
    "sm": 12,
    "md": 18,
    "lg": 24,
    "xl": 32
  },
  "overlayOpacity": {
    "popupFill": 0.82,
    "hudFill": 0.78,
    "careMomentsFill": 0.74,
    "completionFill": 0.72
  },
  "uiSizeRules": {
    "focusHud": {
      "maxWidth": 560,
      "height": "compact-pill",
      "note": "single row, minimal controls"
    },
    "timePicker": {
      "maxWidth": 420,
      "note": "center popup, one primary CTA"
    },
    "careMoments": {
      "maxWidth": 280,
      "note": "icon-first, short label only"
    },
    "completionOverlay": {
      "maxWidth": 320,
      "note": "quiet celebration, do not cover the scene"
    }
  }
}
